{$SERVER_NAME:creativedesk.odi-services.pl} {
    root * /app/public

    encode zstd br gzip

    # Statyczne pliki bez udziału PHP
    file_server

    # Symfony front controller
    php_server {
        try_files {path} /index.php
    }

    header {
        -Server
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
    }

    log {
        output stdout
        format console
    }
}
