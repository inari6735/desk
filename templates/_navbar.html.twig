{% if is_granted('ROLE_PREVIOUS_ADMIN') %}
    <div class="impersonate-bar">
        <span>Impersonating <strong>{{ app.user.displayName }}</strong> ({{ app.user.email }})</span>
        <a href="{{ path('app_home', {_switch_user: '_exit'}) }}" class="btn btn-sm impersonate-exit">Exit</a>
    </div>
{% endif %}
<nav class="navbar">
    <a href="{{ path('app_home') }}" class="navbar-brand">CREATIVEDESK</a>
    <div class="navbar-nav">
        {% if app.user %}
            <a href="{{ path('app_projects') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'app_project' ? 'active' : '' }}">Projects</a>
            <a href="{{ path('app_todos') }}" class="nav-link {{ app.request.attributes.get('_route') == 'app_todos' ? 'active' : '' }}">My Todos</a>
            <a href="{{ path('app_team') }}" class="nav-link {{ app.request.attributes.get('_route') == 'app_team' ? 'active' : '' }}">Team</a>
            <a href="{{ path('app_sessions') }}" class="nav-link nav-link-highlight {{ app.request.attributes.get('_route') starts with 'app_session' ? 'active' : '' }}">Sessions</a>
        {% endif %}
    </div>
    <div class="navbar-links">
        {% if app.user %}
            <a href="{{ path('app_settings') }}" class="navbar-user">
                {% if app.user.avatarUrl %}
                    <img src="{{ app.user.avatarUrl }}" alt="" class="avatar avatar-sm" referrerpolicy="no-referrer">
                {% else %}
                    <span class="avatar avatar-sm avatar-placeholder">{{ app.user.displayName|first|upper }}</span>
                {% endif %}
                <span>{{ app.user.displayName }}</span>
            </a>
            <a href="{{ path('app_logout') }}" class="btn btn-outline btn-sm">Sign out</a>
        {% else %}
            <a href="{{ path('app_login') }}" class="btn btn-outline btn-sm">Sign in</a>
            <a href="{{ path('app_register') }}" class="btn btn-primary btn-sm">Create account</a>
        {% endif %}
    </div>
</nav>
