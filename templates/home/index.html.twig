{% extends 'base.html.twig' %}

{% block title %}Home{% endblock %}

{% block body %}
<div class="home-page">
    <nav class="navbar">
        <a href="{{ path('app_home') }}" class="navbar-brand">Stronka</a>
        <div class="navbar-links">
            {% if app.user %}
                <span class="navbar-user">{{ app.user.email }}</span>
                <a href="{{ path('app_logout') }}" class="btn btn-outline">Sign out</a>
            {% else %}
                <a href="{{ path('app_login') }}" class="btn btn-outline">Sign in</a>
                <a href="{{ path('app_register') }}" class="btn btn-primary btn-sm">Create account</a>
            {% endif %}
        </div>
    </nav>

    <main class="home-content">
        <h1>Welcome{% if app.user %}, {{ app.user.email }}{% endif %}!</h1>
        <p>You're signed in and ready to go.</p>
    </main>
</div>
{% endblock %}
