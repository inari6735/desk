{% extends 'base.html.twig' %}

{% block title %}CREATIVEDESK{% endblock %}

{% block body %}
<div class="home-page">
    {% include '_navbar.html.twig' %}

    {% if app.user and stats %}
        <main class="container">
            <div class="dashboard-greeting">
                <div>
                    <h1>Good {{ 'now'|date('G') < 12 ? 'morning' : ('now'|date('G') < 18 ? 'afternoon' : 'evening') }}, {{ app.user.displayName }}.</h1>
                    <p class="text-muted">Here's your {{ stats.monthName }} overview.</p>
                </div>
                <a href="{{ path('app_sessions') }}" class="btn btn-primary">Log Session</a>
            </div>

            <div class="dashboard-stats">
                <div class="stat-card stat-card-accent">
                    <span class="stat-value">{{ stats.todayHours|number_format(1) }}h</span>
                    <span class="stat-label">Today</span>
                </div>
                <div class="stat-card">
                    <span class="stat-value">{{ stats.weekHours|number_format(1) }}h</span>
                    <span class="stat-label">This Week</span>
                </div>
                <div class="stat-card">
                    <span class="stat-value">{{ stats.monthHours|number_format(1) }}h</span>
                    <span class="stat-label">This Month</span>
                </div>
                <div class="stat-card">
                    <span class="stat-value">{{ stats.daysWorked }}</span>
                    <span class="stat-label">Days Worked</span>
                </div>
                <div class="stat-card">
                    <span class="stat-value">{{ stats.avgPerDay|number_format(1) }}h</span>
                    <span class="stat-label">Avg / Day</span>
                </div>
                <div class="stat-card">
                    <span class="stat-value">{{ stats.activeProjects }}</span>
                    <span class="stat-label">Active Projects</span>
                </div>
            </div>

            {% if stats.missingNotesCount > 0 %}
                <div class="dashboard-notice notice-warning">
                    <div class="notice-content">
                        <strong>{{ stats.missingNotesCount }} session{{ stats.missingNotesCount != 1 ? 's' : '' }} missing notes</strong>
                        <p>You have sessions this month without descriptions. Adding notes helps track what you worked on.</p>
                        <div class="notice-items">
                            {% for entry in stats.missingNotes|slice(0, 5) %}
                                <a href="{{ path('app_session_edit', {id: entry.id}) }}" class="notice-item">
                                    {{ entry.date|date('M d') }} &middot; {{ entry.todo.project.name }} &mdash; {{ entry.todo.title }} ({{ entry.computedHours|number_format(1) }}h)
                                </a>
                            {% endfor %}
                            {% if stats.missingNotesCount > 5 %}
                                <span class="text-muted">and {{ stats.missingNotesCount - 5 }} more...</span>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="dashboard-notice notice-success">
                    <strong>All session notes complete</strong>
                    <p>Every session log this month has a description. Nice work!</p>
                </div>
            {% endif %}

            <div class="dashboard-grid">
                <div class="dashboard-section">
                    <h2>Quick Links</h2>
                    <div class="quick-links">
                        <a href="{{ path('app_sessions') }}" class="quick-link">
                            <span class="quick-link-icon">&#9716;</span>
                            <div>
                                <strong>Sessions</strong>
                                <span>Log and review your work</span>
                            </div>
                        </a>
                        <a href="{{ path('app_todos') }}" class="quick-link">
                            <span class="quick-link-icon">&#9745;</span>
                            <div>
                                <strong>My Todos</strong>
                                <span>{{ stats.myTodosCount }} task{{ stats.myTodosCount != 1 ? 's' : '' }} assigned</span>
                            </div>
                        </a>
                        <a href="{{ path('app_projects') }}" class="quick-link">
                            <span class="quick-link-icon">&#9881;</span>
                            <div>
                                <strong>Projects</strong>
                                <span>View project boards</span>
                            </div>
                        </a>
                        <a href="{{ path('app_team') }}" class="quick-link">
                            <span class="quick-link-icon">&#9787;</span>
                            <div>
                                <strong>Team</strong>
                                <span>Browse the team directory</span>
                            </div>
                        </a>
                    </div>
                </div>

                {% if stats.activeProjectNames|length > 0 %}
                    <div class="dashboard-section">
                        <h2>Active Projects This Month</h2>
                        <div class="active-project-list">
                            {% for name in stats.activeProjectNames %}
                                <span class="badge">{{ name }}</span>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            </div>
        </main>
    {% else %}
        <main class="home-content">
            <h1>Welcome to CREATIVEDESK</h1>
            <p>Project management and time tracking for creative teams.</p>
            <div class="home-actions">
                <a href="{{ path('app_login') }}" class="btn btn-primary">Sign in</a>
                <a href="{{ path('app_register') }}" class="btn btn-outline">Create account</a>
            </div>
        </main>
    {% endif %}
</div>
{% endblock %}
