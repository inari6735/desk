{% extends 'base.html.twig' %}

{% block title %}Home{% endblock %}

{% block body %}
<div class="home-page">
    {% include '_navbar.html.twig' %}

    <main class="home-content">
        {% if app.user %}
            <h1>Welcome, {{ app.user.displayName }}</h1>
            <p>Manage your projects and todos.</p>
            <div class="home-actions">
                <a href="{{ path('app_projects') }}" class="btn btn-primary">View Projects</a>
                <a href="{{ path('app_todos') }}" class="btn btn-outline">My Todos</a>
            </div>
        {% else %}
            <h1>Welcome to Stronka</h1>
            <p>Sign in to manage your projects and todos.</p>
            <div class="home-actions">
                <a href="{{ path('app_login') }}" class="btn btn-primary">Sign in</a>
            </div>
        {% endif %}
    </main>
</div>
{% endblock %}
