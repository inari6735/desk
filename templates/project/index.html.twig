{% extends 'base.html.twig' %}

{% block title %}Projects{% endblock %}

{% block body %}
<div class="app-layout">
    {% include '_navbar.html.twig' %}

    <main class="container">
        <div class="page-header">
            <h1>Projects</h1>
        </div>

        {% if projects is empty %}
            <div class="empty-state">
                <p>No projects yet.</p>
            </div>
        {% else %}
            <div class="card-grid">
                {% for project in projects %}
                    <a href="{{ path('app_project_show', {id: project.id}) }}" class="project-card">
                        <h2>{{ project.name }}</h2>
                        {% if project.description %}
                            <p class="project-description">{{ project.description|u.truncate(120, '...') }}</p>
                        {% endif %}
                        <div class="project-meta">
                            <span class="badge">{{ project.todos|length }} todo{{ project.todos|length != 1 ? 's' : '' }}</span>
                            {% if project.budgetHours %}
                                <span class="badge {{ project.budgetUsagePercent > 90 ? 'badge-danger' : '' }}">{{ project.totalSpentHours|number_format(1) }} / {{ project.budgetHours|number_format(1) }}h</span>
                            {% endif %}
                            <span class="meta-date">{{ project.createdAt|date('M d, Y') }}</span>
                        </div>
                        {% if project.budgetHours %}
                            {% set percent = min(max(project.budgetUsagePercent, 0), 100) %}
                            <div class="progress-track progress-track-sm">
                                <div class="progress-fill {{ project.budgetUsagePercent > 90 ? 'progress-danger' : (project.budgetUsagePercent > 70 ? 'progress-warning' : '') }}" style="width: {{ percent }}%"></div>
                            </div>
                        {% endif %}
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </main>
</div>
{% endblock %}
