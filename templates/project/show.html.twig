{% extends 'base.html.twig' %}

{% block title %}{{ project.name }}{% endblock %}

{% block body %}
<div class="app-layout">
    {% include '_navbar.html.twig' %}

    <main class="container">
        {% for message in app.flashes('success') %}
            <div class="flash flash-success">{{ message }}</div>
        {% endfor %}

        <div class="page-header page-header-row">
            <div>
                <a href="{{ path('app_projects') }}" class="back-link">&larr; Projects</a>
                <h1>{{ project.name }}</h1>
                {% if project.description %}
                    <p class="page-description">{{ project.description }}</p>
                {% endif %}
            </div>
            {% if canCreateTodo %}
                <a href="{{ path('app_todo_new', {id: project.id}) }}" class="btn btn-primary">+ New Todo</a>
            {% endif %}
        </div>

        {% set spent = project.totalSpentHours %}
        {% set estimated = project.totalEstimatedHours %}
        {% set budget = project.budgetHours %}
        {% set remaining = project.remainingBudgetHours %}
        {% set usagePercent = project.budgetUsagePercent %}

        <div class="budget-bar">
            <div class="budget-stats">
                <div class="budget-stat">
                    <span class="budget-label">Spent</span>
                    <span class="budget-value">{{ spent|number_format(1) }}h</span>
                </div>
                <div class="budget-stat">
                    <span class="budget-label">Estimated</span>
                    <span class="budget-value">{{ estimated|number_format(1) }}h</span>
                </div>
                {% if budget %}
                    <div class="budget-stat">
                        <span class="budget-label">Budget</span>
                        <span class="budget-value">{{ budget|number_format(1) }}h</span>
                    </div>
                    <div class="budget-stat">
                        <span class="budget-label">Remaining</span>
                        <span class="budget-value {{ remaining < 0 ? 'overdue' : '' }}">{{ remaining|number_format(1) }}h</span>
                    </div>
                {% endif %}
            </div>
            {% if budget %}
                {% set percent = min(max(usagePercent, 0), 100) %}
                <div class="progress-track">
                    <div class="progress-fill {{ usagePercent > 90 ? 'progress-danger' : (usagePercent > 70 ? 'progress-warning' : '') }}" style="width: {{ percent }}%"></div>
                </div>
                <div class="budget-percent {{ usagePercent > 100 ? 'overdue' : '' }}">{{ usagePercent|number_format(0) }}% used</div>
            {% endif %}
        </div>

        {% if actionBreakdown|length > 0 and totalTrackedHours > 0 %}
            <div class="action-breakdown">
                <h2>Time by Activity</h2>
                <div class="action-bar">
                    {% for item in actionBreakdown %}
                        {% set pct = (item.hours / totalTrackedHours) * 100 %}
                        {% if pct >= 1 %}
                            <div class="action-bar-segment" style="width: {{ pct }}%; background: {{ item.type ? item.type.color : '#a8a8a8' }}" title="{{ item.type ? item.type.label : 'Uncategorized' }}: {{ item.hours|number_format(1) }}h ({{ pct|number_format(0) }}%)"></div>
                        {% endif %}
                    {% endfor %}
                </div>
                <div class="action-legend">
                    {% for item in actionBreakdown %}
                        {% set pct = (item.hours / totalTrackedHours) * 100 %}
                        <div class="action-legend-item">
                            <span class="action-legend-dot" style="background: {{ item.type ? item.type.color : '#a8a8a8' }}"></span>
                            <span class="action-legend-label">{{ item.type ? item.type.label : 'Uncategorized' }}</span>
                            <span class="action-legend-value">{{ item.hours|number_format(1) }}h</span>
                            <span class="action-legend-pct">{{ pct|number_format(0) }}%</span>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        {# Group filter tabs #}
        {% if project.taskGroups|length > 0 %}
            <div class="group-tabs">
                <a href="{{ path('app_project_show', {id: project.id}) }}" class="group-tab {{ currentGroup is null ? 'active' : '' }}">
                    All
                    <span class="group-tab-count">{{ project.todos|length }}</span>
                </a>
                {% for group in project.taskGroups %}
                    <a href="{{ path('app_project_show', {id: project.id, group: group.id}) }}" class="group-tab {{ currentGroup and currentGroup.id == group.id ? 'active' : '' }}" {% if group.color %}style="--group-color: {{ group.color }}"{% endif %}>
                        {% if group.color %}<span class="group-dot" style="background: {{ group.color }}"></span>{% endif %}
                        {{ group.name }}
                        <span class="group-tab-count">{{ group.todos|length }}</span>
                    </a>
                {% endfor %}
            </div>
        {% endif %}

        {% set overrunTodos = todos|filter(t => t.estimatedHours and t.spentHours and t.spentHours > t.estimatedHours) %}
        {% if overrunTodos|length > 0 %}
            <div class="overrun-panel">
                <div class="overrun-header">
                    <h2>Overrun Tasks{% if currentGroup %} — {{ currentGroup.name }}{% endif %}</h2>
                    <span class="overrun-count">{{ overrunTodos|length }}</span>
                </div>
                <div class="overrun-list">
                    {% for todo in overrunTodos %}
                        {% set overrunHours = todo.spentHours - todo.estimatedHours %}
                        {% set overrunPct = ((todo.spentHours / todo.estimatedHours) * 100 - 100) %}
                        <a href="{{ path('app_todo_show', {id: todo.id}) }}" class="overrun-item">
                            <div class="overrun-item-info">
                                <span class="overrun-item-title">{{ todo.title }}</span>
                                <span class="overrun-item-hours">{{ todo.spentHours|number_format(1) }}h / {{ todo.estimatedHours|number_format(1) }}h est.</span>
                            </div>
                            <div class="overrun-item-indicator">
                                <span class="overrun-badge">+{{ overrunHours|number_format(1) }}h ({{ overrunPct|number_format(0) }}%)</span>
                            </div>
                        </a>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        <div class="todo-board">
            {% set statuses = {'todo': 'To Do', 'in_progress': 'In Progress', 'done': 'Done'} %}
            {% for statusValue, statusLabel in statuses %}
                <div class="todo-column">
                    <h3 class="column-header column-{{ statusValue }}">
                        {{ statusLabel }}
                        <span class="column-count">{{ todos|filter(t => t.status.value == statusValue)|length }}</span>
                    </h3>
                    <div class="todo-list">
                        {% for todo in todos|filter(t => t.status.value == statusValue) %}
                            <div class="todo-card">
                                <div class="todo-card-header">
                                    <a href="{{ path('app_todo_show', {id: todo.id}) }}" class="todo-title-link">{{ todo.title }}</a>
                                    {% if canEditTodo %}
                                        <div class="todo-actions">
                                            <a href="{{ path('app_todo_edit', {id: todo.id}) }}" class="todo-action" title="Edit">&#9998;</a>
                                            <form method="post" action="{{ path('app_todo_delete', {id: todo.id}) }}" class="inline-form" onsubmit="return confirm('Delete this todo?')">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete-todo-' ~ todo.id) }}">
                                                <button type="submit" class="todo-action todo-action-delete" title="Delete">&times;</button>
                                            </form>
                                        </div>
                                    {% endif %}
                                </div>
                                {% if todo.taskGroups|length > 0 %}
                                    <div class="todo-groups">
                                        {% for group in todo.taskGroups %}
                                            <span class="group-badge" {% if group.color %}style="--group-color: {{ group.color }}"{% endif %}>{{ group.name }}</span>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                                {% if todo.description %}
                                    <p class="todo-description">{{ todo.description|u.truncate(80, '...') }}</p>
                                {% endif %}
                                {% if todo.estimatedHours or todo.spentHours %}
                                    <div class="todo-hours">
                                        {% if todo.spentHours %}
                                            <span class="hours-spent">{{ todo.spentHours|number_format(1) }}h spent</span>
                                        {% endif %}
                                        {% if todo.estimatedHours %}
                                            <span class="hours-est">/ {{ todo.estimatedHours|number_format(1) }}h est.</span>
                                        {% endif %}
                                    </div>
                                {% endif %}
                                <div class="todo-meta">
                                    {% if todo.assignedTo %}
                                        <span class="todo-assignee">
                                            {% if todo.assignedTo.avatarUrl %}
                                                <img src="{{ todo.assignedTo.avatarUrl }}" alt="" class="avatar avatar-xs" referrerpolicy="no-referrer">
                                            {% else %}
                                                <span class="avatar avatar-xs avatar-placeholder">{{ todo.assignedTo.displayName|first|upper }}</span>
                                            {% endif %}
                                            {{ todo.assignedTo.displayName }}
                                        </span>
                                    {% endif %}
                                    {% if todo.dueDate %}
                                        <span class="todo-due {{ todo.dueDate < date() and todo.status.value != 'done' ? 'overdue' : '' }}">
                                            {{ todo.dueDate|date('M d') }}
                                        </span>
                                    {% endif %}
                                </div>
                            </div>
                        {% else %}
                            <div class="todo-empty">No items</div>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}
        </div>

        {% if project.members|length > 0 %}
            <div class="project-members">
                <h2>Members</h2>
                <div class="members-list">
                    {% for member in project.members %}
                        <div class="member-item">
                            <div class="member-info">
                                {% if member.user.avatarUrl %}
                                    <img src="{{ member.user.avatarUrl }}" alt="" class="avatar avatar-sm" referrerpolicy="no-referrer">
                                {% else %}
                                    <span class="avatar avatar-sm avatar-placeholder">{{ member.user.displayName|first|upper }}</span>
                                {% endif %}
                                <span class="member-name">{{ member.user.displayName }}</span>
                            </div>
                            <div class="member-permissions">
                                {% for perm in member.permissions %}
                                    <span class="badge badge-sm">{{ perm }}</span>
                                {% endfor %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    </main>
</div>
{% endblock %}
